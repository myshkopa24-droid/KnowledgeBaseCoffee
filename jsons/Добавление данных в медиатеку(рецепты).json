    {
      "parameters": {
        "jsCode": "// 1. Берем РЕЦЕПТЫ из ноды Merge\nconst recipeItems = $('Merge').all();\n\n// 2. Берем ДЕГУСТАЦИИ со входа текущей ноды\nconst degustationItems = $input.all();\n\nconst results = [];\n\n// Функция для очистки строк (убираем скобки и приводим к нижнему регистру)\nfunction normalizeText(text) {\n  if (!text) return \"\";\n  return String(text)\n    .toLowerCase()\n    .replace(/\\([^)]*\\)/g, \"\")\n    .trim();\n}\n\n// Перебираем каждый РЕЦЕПТ\nfor (const recipeItem of recipeItems) {\n  // Блок 1: Определение способов приготовления по тексту рецепта \n  let recipeText = \"\";\n  if (recipeItem.json.recipy) {\n    if (Array.isArray(recipeItem.json.recipy)) {\n      recipeText = recipeItem.json.recipy.join(\" \").toLowerCase();\n    } else {\n      recipeText = String(recipeItem.json.recipy).toLowerCase();\n    }\n  }\n\n  const methodsConfig = [\n    { name: \"Френч-пресс\", keywords: [\"френч-пресс\", \"french press\"], id: \"3db31822858680a483cdfd408b65157f\" },\n    { name: \"V60 / Пуровер\", keywords: [\"пуровер\", \"v60\", \"drip\"], id: \"3db318228586808c88cbefd9016fdd7b\" },\n    { name: \"Аэропресс\", keywords: [\"аэропресс\", \"aeropress\"], id: \"3db3182285868014827ed1311185e2b8\" },\n    { name: \"Джезва / Турка\", keywords: [\"джезв\", \"турк\", \"cezve\"], id: \"3db318228586803c941bd3f7265612ca\" },\n    { name: \"Эспрессо\", keywords: [\"эспрессо\", \"espresso\"], id: \"3db31822858680d2a27cf783f941b4e6\" }\n  ];\n\n  const matchedIds = [];\n  const matchedNames = [];\n\n  for (const method of methodsConfig) {\n    const found = method.keywords.some(keyword => recipeText.includes(keyword));\n    if (found) {\n      matchedIds.push(method.id);\n      matchedNames.push(method.name);\n    }\n  }\n\n  // Блок 2: Поиск совпадений названия рецепта в журнале дегустаций\n  const rawRecipeTitle = recipeItem.json.title || \"\";\n  const recipeTitleFull = rawRecipeTitle.toLowerCase().trim();\n  const recipeTitleClean = normalizeText(rawRecipeTitle);\n\n  const matchedDegustationIds = [];\n\n  for (const degItem of degustationItems) {\n    const rawDegTitle = degItem.json.name || degItem.json.title || \"\";\n    const degTitleFull = String(rawDegTitle).toLowerCase().trim();\n    const degTitleClean = normalizeText(rawDegTitle);\n\n    const isMatch =\n      (recipeTitleFull && degTitleFull && (degTitleFull.includes(recipeTitleFull) || recipeTitleFull.includes(degTitleFull))) ||\n      (recipeTitleClean && degTitleClean && (degTitleClean.includes(recipeTitleClean) || recipeTitleClean.includes(degTitleClean)));\n\n    if (isMatch) {\n      const pageId = degItem.json.id;\n      if (pageId && !matchedDegustationIds.includes(pageId)) {\n        matchedDegustationIds.push(pageId);\n      }\n    }\n  }\n\n  // Возвращаем данные РЕЦЕПТА + найденные ID\n  results.push({\n    json: {\n      ...recipeItem.json,\n      matchedRelationIds: matchedIds,\n      matchedMethodNames: matchedNames,\n      matchedDegustationIds: matchedDegustationIds\n    }\n  });\n}\n\nreturn results;"
      },
